# Telegram Bot Configuration
# Получить токен можно у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Configuration
# Зарегистрироваться можно на https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель LLM (опционально, используется бесплатная модель по умолчанию)
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# Whisper Configuration (опционально, по умолчанию используется turbo)
# Варианты: tiny, base, small, medium, large, turbo
WHISPER_MODEL=turbo
