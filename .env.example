# --- Public access (Mini App must be served over HTTPS) ---
# sslip.io: dash-separated VPS IP, e.g. 203-0-113-5.sslip.io
PUBLIC_HOST=

# --- Telegram ---
BOT_TOKEN=
INIT_DATA_MAX_AGE_SECONDS=86400

# --- PostgreSQL ---
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://finance:change-me@db:5432/finance

# --- LLM ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# --- Speech to text ---
WHISPER_MODEL=small
WHISPER_TEMP_DIR=/tmp/temp_audio

# --- Behaviour ---
# 0 disables deletion of old transactions
AUTO_CLEANUP_MONTHS=0
LOG_LEVEL=INFO
